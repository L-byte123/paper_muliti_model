{
  "text_backend": "bert",
  "bert_model": "google-bert/bert-base-uncased",
  "text_scope": "patch",
  "route": "prose",
  "text_context_layers": 1,
  "max_text_length": 256,
  "paper_class_ratios": true,
  "batch_size": 4,
  "accumulation_steps": 16,
  "bert_chunk_size": 8,
  "amp": true,
  "cache_tokens": false
}
