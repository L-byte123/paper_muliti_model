{
  "text_backend": "bert",
  "bert_model": "google-bert/bert-base-uncased",
  "text_scope": "patch",
  "route": "prose",
  "d_model": 128,
  "heads": 8,
  "batch_size": 64,
  "epochs": 5,
  "patience": 2,
  "lr": 0.0001,
  "num_classes": 4,
  "paper_class_ratios": true,
  "text_context_layers": 1,
  "text_context_ff": 512,
  "max_text_length": 256,
  "split_mode": "group",
  "cache_tokens": true,
  "amp": false,
  "accumulation_steps": 1
}
